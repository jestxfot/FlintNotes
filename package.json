{
  "name": "flintnotes",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "nodemon --legacy-watch --watch server --watch shared --ext ts --exec tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "release": "node scripts/release.mjs",
    "installer": "node scripts/publish-build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vite build && node e2e/run.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@lezer/javascript": "^1.5.6",
    "chart.js": "^4.5.1",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "docx-preview": "^0.4.1",
    "hono": "^4.13.13",
    "lucide-static": "^0.577.0",
    "mermaid": "^11.17.2",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron/get": "5.1.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.19.43",
    "7zip-bin": "5.2.0",
    "concurrently": "^9.2.5",
    "electron": "44.9.3",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "playwright": "^1.64.0",
    "resedit": "2.0.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.4"
  }
}
